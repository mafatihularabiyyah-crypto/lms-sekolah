// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// --- TABEL LMS MULTI-TENANT --- //

model Tenant {
  id              String           @id @default(cuid())
  name            String
  domain          String?          @unique
  createdAt       DateTime         @default(now())

  // Relasi ke seluruh tabel yang dimiliki oleh Instansi/Sekolah ini
  users           User[]
  courses         Course[]
  studentProfiles StudentProfile[]
  teacherProfiles TeacherProfile[]
  classRooms      ClassRoom[]
  cbtExams        CbtExam[]
  systemSettings  SystemSettings?
  materi          Materi[]
  pengumuman      Pengumuman[]
  tagihan         Tagihan[]
  paymentSetting  PaymentSetting?
  buku            Buku[]
}

enum Role {
  ADMIN
  GURU
  SANTRI
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  image           String?          @db.Text
  password        String   
  role            String           @default("SANTRI")
  isActive        Boolean          @default(true)
  
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  courses         Course[]         @relation("CourseTeacher")
  enrollments     Enrollment[]
  attendances     Attendance[]
  materialProgress MaterialProgress[]
  studentProfile  StudentProfile? 
  teacherProfile  TeacherProfile?
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  teacherId   String
  teacher     User     @relation("CourseTeacher", fields: [teacherId], references: [id])
  
  enrollments Enrollment[]
  materials   Material[]
  sessions    Session[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  
  @@unique([userId, courseId]) 
}

// --- FITUR MATERI & PRESENSI --- //

enum MaterialType {
  VIDEO
  DOCUMENT
  LINK
}

model Material {
  id        String       @id @default(cuid())
  title     String
  type      MaterialType 
  url       String?      
  content   String?      
  createdAt DateTime     @default(now())
  
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Session {
  id          String       @id @default(cuid())
  title       String       
  date        DateTime     @default(now())
  
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances Attendance[]
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
}

model Attendance {
  id        String           @id @default(cuid())
  status    AttendanceStatus @default(HADIR)
  
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId]) 
}

// --- FITUR PROFIL AKADEMIK --- //

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum StudentStatus {
  AKTIF
  CUTI
  LULUS
  KELUAR
}

model StudentProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  nis            String        @unique
  gender         Gender
  enrollYear     Int
  parentName     String?
  parentPhone    String?
  address        String?
  birthPlace     String?  
  status         StudentStatus @default(AKTIF)

  classes        ClassRoom[]  
  tagihan        Tagihan[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  nip         String?
  gender      Gender?
  subject     String?  
  phone       String?
  address     String?
  status      String?  @default("Aktif") 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassRoom {
  id             String             @id @default(cuid())
  
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name           String             
  program        String?
  pengajar       String?
  jadwal         String?
  kkm            Int                @default(75)
  kapasitas      Int                @default(30)
  isFinished     Boolean            @default(false)
  
  weights        Json?    
  waGroupLink    String?
  zoomLink       String?
  certBackground String?  
  
  students       StudentProfile[]
  materials      LearningMaterial[]
  attendances    ClassAttendance[]
  grades         ClassGrade[]
  materi         Materi[]
  tagihan        Tagihan[]
  
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([tenantId, name]) // Nama kelas harus unik di dalam 1 sekolah
}

model LearningMaterial {
  id          String    @id @default(cuid())
  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  youtubeLink String?  
  fileUrl     String?  
  isPublished Boolean   @default(true)
  order       Int       @default(0)
  progress         MaterialProgress[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CbtExam {
  id          String      @id @default(cuid())
  
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  judul       String
  deskripsi   String?
  coverImage  String?
  token       String?
  durasi      Int         @default(60)
  kkm         Int         @default(75)
  acakSoal    Boolean     @default(true)
  antiCheat   Boolean     @default(true)
  butuhToken  Boolean     @default(true)
  deadline    DateTime?
  isAktif     Boolean     @default(true)
  namaKelas   String?    
  
  dataSoal    Json      
  
  results     CbtResult[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CbtResult {
  id            String   @id @default(cuid())
  examId        String
  exam          CbtExam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  namaPeserta   String
  emailPeserta  String
  
  nilai         Float    @default(0)
  detailJawaban Json     
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClassAttendance {
  id          String    @id @default(cuid())
  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  studentId   String
  
  hadir       Int       @default(0)
  sakit       Int       @default(0)
  izin        Int       @default(0)
  alpa        Int       @default(0)

  @@unique([classRoomId, studentId]) 
}

model ClassGrade {
  id          String    @id @default(cuid())
  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  studentId   String
  
  tugas1      Float?
  tugas2      Float?
  tugas3      Float?
  tugas4      Float?
  tugas5      Float?
  uts         Float?
  uas         Float?
  nilaiAkhir  Float?
  certLink    String?

  @@unique([classRoomId, studentId]) 
}

// Pengaturan sekarang spesifik per Instansi/Tenant
model SystemSettings {
  id          String   @id @default(cuid())
  
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  schoolName  String   @default("LMS Pesantren")
  schoolLogo  String?  @db.Text 
  
  adminName   String?  @default("Staff Tata Usaha")
  adminTtd    String?  @db.Text 
  kepsekName  String?  @default("Kepala Sekolah")
  kepsekNip   String?
  kepsekTtd   String?  @db.Text 

  updatedAt   DateTime @updatedAt
}

model Materi {
  id          String    @id @default(cuid())
  judul       String
  deskripsi   String?   @db.Text
  tipe        String    // Wajib diisi dengan: "PDF", "VIDEO", "LINK", atau "DOC"
  fileUrl     String    // Link URL file, Google Drive, atau YouTube
  
  // Relasi ke Kelas
  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  
  // Keamanan Institusi
  tenantId    String    
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Pengumuman {
  id        String   @id @default(cuid())
  judul     String
  konten    String   @db.Text
  kategori  String   // Contoh: "PROMO", "KAJIAN", "BERITA", "INFO"
  imageUrl  String?  @db.Text // Untuk menyimpan poster/gambar (Base64/URL)
  actionLink  String?
  isActive  Boolean  @default(true)
  
  // Relasi Multi-Tenant (Sangat Penting)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tagihan {
  id          String   @id @default(cuid())
  tipe        String   // Contoh: "BULANAN", "TAHUNAN"
  judul       String   // Contoh: "SPP Agustus 2026"
  nominal     Int
  status      String   @default("BELUM_BAYAR") // "BELUM_BAYAR" atau "LUNAS"
  
  // Relasi
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  classRoomId String?
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id], onDelete: SetNull)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentSetting {
  id          String   @id @default(cuid())
  qrisUrl     String?  @db.Text
  bankName    String?
  bankAccount String?
  accountName String?
  
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Buku {
  id            String   @id @default(cuid())
  judul         String
  deskripsi     String?  @db.Text
  coverUrl      String?  @db.Text
  
  isFisik       Boolean  @default(false) // Penanda: false = Digital (PDF), true = Buku Fisik
  fileUrl       String?  // Tautan file PDF (Kosong jika buku fisik)
  nomorWa       String?  // Nomor WA Admin (Kosong jika modul digital)
  
  hargaNormal   Int      @default(0)
  potonganHarga Int      @default(0) // Inputan berupa nominal potongan (misal: 10000)
  
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- FITUR PROGRESS MATERI SANTRI --- //

model MaterialProgress {
  id          String   @id @default(cuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  materiId    String
  material    LearningMaterial @relation(fields: [materiId], references: [id], onDelete: Cascade)
  
  classRoomId String

  createdAt   DateTime @default(now())

  // Mencegah santri merekam progress ganda di materi yang sama
  @@unique([userId, materiId])
}